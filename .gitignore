__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.vscode/
.claude/
*.lnk
*.log

# Build artifacts and temp files
*.bak
palette_temp*.png
/fusion_to_blender_addon_blender/
Sequence*.gif
# Release zips live on GitHub Releases (built by CI on tag), not in git
/*.zip

# Orchestrator operational files — not version-controlled
# (already-tracked docs files stay tracked; only new ones are ignored)
/CLAUDE.md
/docs/

# Autonomous-loop orchestrator state (local only, not part of the product)
/features.json
/profile.json
/usage.json
/insights.json
/usage_budget.json
/scripts/

# 확장 빌드 산출물
/build/

# Real customer geometry used as a regression fixture. These files are someone's
# actual product design, and this repository is public -- the tests look for them
# and skip when they are absent, so nothing breaks by leaving them out.
tests/fixtures/*.blend
# Blender's numbered auto-backups slip past *.blend -- one did, and it was a
# real product model. The pattern has to say so explicitly.
tests/fixtures/*.blend[0-9]
